{
  "name": "frontier-frontend-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/showcase"
  ],
  "scripts": {
    "dev": "vite",
    "dev:showcase": "npm --prefix apps/showcase run dev",
    "build": "tsc -b && vite build",
    "build:showcase": "npm --prefix apps/showcase run build",
    "build:analyze": "BUNDLE_ANALYZE=true npm run build",
    "build:staging": "tsc -b && vite build --mode staging",
    "build:production": "tsc -b && vite build --mode production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,apps/showcase/src}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{src,apps/showcase/src}/**/*.{ts,tsx,css}\"",
    "type-check": "tsc -b && tsc -p tsconfig.spec.json --noEmit && npm --prefix apps/showcase run type-check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:showcase": "npm --prefix apps/showcase run test:run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:showcase:coverage": "npm --prefix apps/showcase run test:coverage",
    "preview": "vite preview",
    "preview:showcase": "npm --prefix apps/showcase run preview",
    "audit": "npm audit --audit-level=high",
    "prepare": "husky",
    "cli:build": "cd packages/cli && npm run build",
    "sync:templates": "node scripts/sync-templates.mjs",
    "sync:templates:check": "node scripts/sync-templates.mjs --check",
    "check:registry": "node scripts/check-registry.mjs",
    "smoke:cli": "node scripts/smoke-cli.mjs",
    "smoke:docker": "node scripts/smoke-docker.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.14",
    "axios": "1.19.0",
    "clsx": "^2.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.1",
    "react-router-dom": "^7.15.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.4.0",
    "msw": "^2.12.7",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
